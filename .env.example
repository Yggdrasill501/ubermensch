# --- Claude ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Slack (Socket Mode app, see docs/SETUP.md) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_DEFAULT_CHANNEL=C0123456789   # channel id where the agent reports work, e.g. #ubermensch

# --- GitHub ---
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-user/ubermensch-demo   # the repo the agent works on (NOT this repo)

# --- Linear ---
LINEAR_API_KEY=lin_api_...
LINEAR_TEAM_KEY=ENG
LINEAR_LABEL=ubermensch   # the agent picks up issues with this label (empty = all backlog)

# --- Optional tools for workers ---
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Tuning ---
# WORKSPACES_DIR=~/ubermensch-workspaces
# MAX_WORKERS=3
# WORKER_MAX_TURNS=80
# HEARTBEAT_MINUTES=5

# --- Worker backend ---
# WORKER_BACKEND=cursor   # "cursor" (Cursor Cloud Agents, default when CURSOR_API_KEY is set) or "claude"
CURSOR_API_KEY=
# CURSOR_MODEL=           # omit for Cursor's default model
# AUTO_MERGE=true         # squash-merge agent PRs once CI is green
MERGE_APPROVAL=never      # "approve?" in Slack before merging: playbook | always | never (never = merges its own PRs)
