{
  "name": "ubermensch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,agent -c blue,magenta \"next dev\" \"npm run agent\"",
    "web": "next dev",
    "agent": "tsx watch --env-file=.env agent/index.ts",
    "build": "next build",
    "start": "concurrently -k -n web,agent \"next start\" \"tsx --env-file-if-exists=.env agent/index.ts\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@anthropic-ai/sdk": "^0.129.0",
    "@linear/sdk": "^97.0.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.1.0",
    "better-sqlite3": "^13.0.3",
    "daisyui": "^5.7.47",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
